# FireSignal Backend Configuration

# NASA FIRMS MAP_KEY
# Get your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_map_key_here

# Server Settings
ENVIRONMENT=development
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Data Paths (relative to backend execution root or absolute)
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
DATA_SAMPLE_DIR=../data/sample
DATA_BOUNDARIES_DIR=../data/boundaries
